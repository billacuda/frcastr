@page
@model frcastr.Web.Pages.Admin.DataSourcesModel
@using frcastr.Core.Enums
@{
    ViewData["Title"] = "Data Sources";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-3">
        <h1 class="h3 mb-0 me-auto">Data Sources</h1>
        <button class="btn btn-primary btn-sm" onclick="openAddModal()">+ Add Source</button>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead>
                <tr><th>Name</th><th>Type</th><th>Enabled</th><th>Poll (s)</th><th>Last Polled</th><th>Last Error</th><th></th></tr>
            </thead>
            <tbody id="sourcesBody">
                @foreach (var s in Model.Sources)
                {
                    <tr id="row-@s.Id" data-source='@System.Text.Json.JsonSerializer.Serialize(s, DataSourcesModel.JsonOpts)'>
                        <td class="fw-semibold">@s.Name</td>
                        <td><span class="badge text-bg-secondary">@s.Type</span></td>
                        <td>
                            @if (s.IsEnabled)
                            { <span class="badge text-bg-success">Enabled</span> }
                            else
                            { <span class="badge text-bg-secondary">Disabled</span> }
                        </td>
                        <td>@(s.Type is DataSourceType.Pull or DataSourceType.Forecast or DataSourceType.Alerts or DataSourceType.AirQuality ? s.PollIntervalSeconds.ToString() : "–")</td>
                        <td class="small text-body-secondary">@(s.LastPolledAt?.ToString("MM/dd HH:mm") ?? "–")</td>
                        <td class="small text-danger text-truncate" style="max-width:200px" title="@s.LastError">@(s.LastError ?? "")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary" onclick="toggleSource(@s.Id)">Toggle</button>
                                <button class="btn btn-outline-primary"   onclick="openEditModal(@s.Id)">Edit</button>
                                <button class="btn btn-outline-info"      onclick="testSourceById(@s.Id, '@s.Name')">Test</button>
                                @if (s.Type == DataSourceType.Push)
                                {
                                    <button class="btn btn-outline-warning" onclick="rotateKey(@s.Id)">Rotate Key</button>
                                }
                                <button class="btn btn-outline-danger" onclick="deleteSource(@s.Id, '@s.Name')">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Add/Edit Modal *@
<div class="modal fade" id="sourceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="sourceModalTitle">Add Data Source</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="sourceId" value="0" />
                <div class="row g-3">
                    <div class="col-md-8"><label class="form-label">Name</label>
                        <input type="text" class="form-control" id="sourceName" /></div>
                    <div class="col-md-4"><label class="form-label">Type</label>
                        <select class="form-select" id="sourceType" onchange="onTypeChange()">
                            @foreach (var t in DataSourcesModel.AllTypes)
                            { <option value="@t">@t</option> }
                        </select></div>
                    <div class="col-md-4" id="pollRow"><label class="form-label">Poll Interval (s)</label>
                        <input type="number" min="10" class="form-control" id="sourcePoll" value="300" /></div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="sourceEnabled" checked />
                            <label class="form-check-label" for="sourceEnabled">Enabled</label>
                        </div>
                    </div>
                    <div class="col-12" id="urlRow"><label class="form-label">URL</label>
                        <input type="url" class="form-control font-monospace" id="sourceUrl" placeholder="https://example.com/api/data" /></div>
                    <div class="col-12">
                        <label class="form-label">Provider preset <span class="text-body-secondary small">(fills the config below)</span></label>
                        <select class="form-select" id="providerPreset" onchange="applyPreset()">
                            <option value="">— Choose a provider —</option>
                            <option value="nws-current">NWS Current Conditions (api.weather.gov)</option>
                            <option value="nws">NWS Forecast (api.weather.gov)</option>
                            <option value="openweathermap">OpenWeatherMap (current + forecast)</option>
                            <option value="weatherapi">WeatherAPI.com (forecast)</option>
                            <option value="open-meteo-current">Open-Meteo (current conditions)</option>
                            <option value="open-meteo">Open-Meteo (forecast)</option>
                            <option value="airnow">AirNow (air quality)</option>
                            <option value="esp32-mqtt">ESP32 sensors over MQTT (multi-device)</option>
                        </select>
                        <div class="form-text">NWS uses your station's latitude/longitude. Leave lat/lon blank to inherit from Station settings.</div>
                    </div>
                    <div class="col-12"><label class="form-label">Config (JSON)</label>
                        <textarea class="form-control font-monospace" id="sourceConfig" rows="6" placeholder='{"key": "value"}'></textarea>
                    </div>
                    <div class="col-12" id="testResultRow" style="display:none">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="fw-semibold small">Test Result</span>
                            <span id="testStatusBadge"></span>
                        </div>
                        <pre id="testResultPre" class="border rounded p-2 small bg-body-secondary overflow-auto" style="max-height:200px;white-space:pre-wrap"></pre>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-outline-info" id="testSourceBtn" onclick="testSource()" style="display:none">
                    <span id="testSpinner" class="spinner-border spinner-border-sm me-1" style="display:none" role="status"></span>
                    Test
                </button>
                <button type="button" class="btn btn-primary" onclick="saveSource()">Save</button>
            </div>
        </div>
    </div>
</div>

@* Test Result Modal *@
<div class="modal fade" id="testResultModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Test — <span id="trSourceName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span id="trSpinner" class="spinner-border spinner-border-sm" role="status"></span>
                    <span id="trBadge"></span>
                </div>
                <pre id="trOutput" class="border rounded p-2 small bg-body-secondary overflow-auto" style="max-height:300px;white-space:pre-wrap"></pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@* Rotate Key Modal *@
<div class="modal fade" id="keyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">New API Key</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <p class="small text-body-secondary">Copy this key now. It will not be shown again.</p>
                <div class="input-group">
                    <input type="text" class="form-control font-monospace" id="newKeyDisplay" readonly />
                    <button class="btn btn-outline-secondary" onclick="copyKey()">Copy</button>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const noPollTypes  = ['Push', 'Mqtt', 'DataSink', 'RadarMapServer'];
const noUrlTypes   = ['Push', 'Mqtt'];
const testableTypes = ['Forecast', 'Pull', 'AirQuality', 'Alerts', 'Mqtt', 'RadarMapServer'];

function onTypeChange() {
    const t = document.getElementById('sourceType').value;
    document.getElementById('pollRow').style.display   = noPollTypes.includes(t)  ? 'none' : '';
    document.getElementById('urlRow').style.display    = noUrlTypes.includes(t)   ? 'none' : '';
    document.getElementById('testSourceBtn').style.display = testableTypes.includes(t) ? '' : 'none';
    document.getElementById('testResultRow').style.display = 'none';
}

// Provider presets: fill the config template + set an appropriate source Type.
// Leaving latitude/longitude out lets the adapter inherit them from Station settings.
const PROVIDER_PRESETS = {
    'nws-current':        { type: 'Pull',       config: { provider: 'nws-current' } },
    'nws':                { type: 'Forecast',   config: { provider: 'nws' } },
    'openweathermap':     { type: 'Pull',       config: { provider: 'openweathermap', apiKey: '' } },
    'weatherapi':         { type: 'Forecast',   config: { provider: 'weatherapi', apiKey: '' } },
    'open-meteo-current': { type: 'Pull',       config: { provider: 'openmeteo' } },
    'open-meteo':         { type: 'Forecast',   config: { provider: 'openmeteo' } },
    'airnow':             { type: 'AirQuality', config: { provider: 'airnow', apiKey: '' } },
    // Devices auto-register from the {device} segment of topicPattern; one source serves them all.
    'esp32-mqtt':         { type: 'Mqtt', config: {
        broker: '192.168.1.50',
        port: 1883,
        topicPattern: 'frcastr/{device}/state',
        statusTopicPattern: 'frcastr/{device}/status',
        autoRegisterDevices: true,
        username: '',
        password: '',
        fieldMapping: {
            temperature: { channel: 'temperature.indoor', unit: '°C' },
            humidity:    { channel: 'humidity.indoor',    unit: '%'  },
            battery:     { channel: 'battery.voltage',    unit: 'V'  }
        }
    } }
};

function applyPreset() {
    const key = document.getElementById('providerPreset').value;
    const preset = PROVIDER_PRESETS[key];
    if (!preset) return;
    document.getElementById('sourceType').value = preset.type;
    onTypeChange();
    if (!document.getElementById('sourceName').value.trim())
        document.getElementById('sourceName').value = document.getElementById('providerPreset').selectedOptions[0].text;
    document.getElementById('sourceConfig').value = JSON.stringify(preset.config, null, 2);
}

function clearTestResult() {
    document.getElementById('testResultRow').style.display = 'none';
    document.getElementById('testResultPre').textContent = '';
    document.getElementById('testStatusBadge').innerHTML = '';
}

function openAddModal() {
    document.getElementById('sourceId').value = '0';
    document.getElementById('sourceModalTitle').textContent = 'Add Data Source';
    document.getElementById('sourceName').value = '';
    document.getElementById('sourceType').value = 'Pull';
    document.getElementById('sourcePoll').value = '300';
    document.getElementById('sourceEnabled').checked = true;
    document.getElementById('sourceUrl').value = '';
    document.getElementById('sourceConfig').value = '';
    document.getElementById('providerPreset').value = '';
    clearTestResult();
    onTypeChange();
    new bootstrap.Modal('#sourceModal').show();
}

function openEditModal(id) {
    const row = document.getElementById('row-' + id);
    const s = JSON.parse(row.dataset.source);
    document.getElementById('sourceId').value = id;
    document.getElementById('sourceModalTitle').textContent = 'Edit Data Source';
    document.getElementById('sourceName').value = s.name;
    document.getElementById('sourceType').value = s.type;
    document.getElementById('sourcePoll').value = s.pollIntervalSeconds;
    document.getElementById('sourceEnabled').checked = s.isEnabled;
    document.getElementById('sourceUrl').value = s.url ?? '';
    document.getElementById('sourceConfig').value = s.config ? JSON.stringify(JSON.parse(s.config), null, 2) : '';
    document.getElementById('providerPreset').value = '';
    clearTestResult();
    onTypeChange();
    new bootstrap.Modal('#sourceModal').show();
}

async function testSourceById(id, name) {
    document.getElementById('trSourceName').textContent = name;
    document.getElementById('trSpinner').style.display = '';
    document.getElementById('trBadge').innerHTML = '';
    document.getElementById('trOutput').textContent = '';
    const modal = new bootstrap.Modal('#testResultModal');
    modal.show();

    try {
        const r = await fetch('/api/admin/datasources/' + id + '/test', { method: 'POST' });
        const data = await r.json();
        document.getElementById('trSpinner').style.display = 'none';
        document.getElementById('trBadge').innerHTML = data.success
            ? '<span class="badge text-bg-success">OK</span>'
            : '<span class="badge text-bg-danger">Failed</span>';
        const display = { ...(data.error ? { error: data.error } : {}), ...(data.sample ?? {}) };
        document.getElementById('trOutput').textContent = JSON.stringify(display, null, 2);
    } catch (err) {
        document.getElementById('trSpinner').style.display = 'none';
        document.getElementById('trBadge').innerHTML = '<span class="badge text-bg-danger">Error</span>';
        document.getElementById('trOutput').textContent = String(err);
    }
}

async function testSource() {
    const id = parseInt(document.getElementById('sourceId').value);
    if (!id) { alert('Save the source first before testing.'); return; }
    const spinner = document.getElementById('testSpinner');
    const btn = document.getElementById('testSourceBtn');
    const resultRow = document.getElementById('testResultRow');
    const pre = document.getElementById('testResultPre');
    const badge = document.getElementById('testStatusBadge');

    spinner.style.display = '';
    btn.disabled = true;
    resultRow.style.display = 'none';

    try {
        const r = await fetch('/api/admin/datasources/' + id + '/test', { method: 'POST' });
        const data = await r.json();
        resultRow.style.display = '';
        badge.innerHTML = data.success
            ? '<span class="badge text-bg-success">OK</span>'
            : '<span class="badge text-bg-danger">Failed</span>';
        const display = { ...(data.error ? { error: data.error } : {}), ...(data.sample ?? {}) };
        pre.textContent = JSON.stringify(display, null, 2);
    } catch (err) {
        resultRow.style.display = '';
        badge.innerHTML = '<span class="badge text-bg-danger">Error</span>';
        pre.textContent = String(err);
    } finally {
        spinner.style.display = 'none';
        btn.disabled = false;
    }
}

async function saveSource() {
    const id = parseInt(document.getElementById('sourceId').value);
    const body = {
        name: document.getElementById('sourceName').value,
        type: document.getElementById('sourceType').value,
        isEnabled: document.getElementById('sourceEnabled').checked,
        pollIntervalSeconds: parseInt(document.getElementById('sourcePoll').value) || 300,
        url: document.getElementById('sourceUrl').value.trim() || null,
        config: document.getElementById('sourceConfig').value.trim() || null
    };
    const url = id ? '/api/admin/datasources/' + id : '/api/admin/datasources';
    const method = id ? 'PUT' : 'POST';
    const r = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
    if (r.ok) { location.reload(); } else {
        const txt = await r.text();
        alert('Error: ' + txt);
    }
}

async function toggleSource(id) {
    await fetch('/api/admin/datasources/' + id + '/toggle', { method: 'POST' });
    location.reload();
}

async function deleteSource(id, name) {
    if (!confirm('Delete "' + name + '"?')) return;
    await fetch('/api/admin/datasources/' + id, { method: 'DELETE' });
    location.reload();
}

async function rotateKey(id) {
    const r = await fetch('/api/admin/datasources/' + id + '/rotate-key', { method: 'POST' });
    if (!r.ok) { alert('Failed to rotate key'); return; }
    const data = await r.json();
    document.getElementById('newKeyDisplay').value = data.plainKey;
    new bootstrap.Modal('#keyModal').show();
}

function copyKey() {
    const el = document.getElementById('newKeyDisplay');
    el.select();
    document.execCommand('copy');
}
</script>
}
