@page
@model frcastr.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Users";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-3">
        <h1 class="h3 mb-0 me-auto">Users</h1>
        <button class="btn btn-primary btn-sm" onclick="openAddModal()">+ Add User</button>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead><tr><th>Email</th><th>Roles</th><th>Created</th><th></th></tr></thead>
            <tbody>
                @foreach (var row in Model.Users)
                {
                    <tr id="urow-@row.User.Id" data-uid="@row.User.Id" data-email="@row.User.Email"
                        data-roles="@string.Join(",", row.Roles)">
                        <td>@row.User.Email</td>
                        <td>@string.Join(", ", row.Roles)</td>
                        <td class="small text-body-secondary" data-utc="@row.User.CreatedAt.ToUtcAttr()" data-utc-format="date">@row.User.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary" onclick="openRolesModal('@row.User.Id')">Roles</button>
                                <button class="btn btn-outline-secondary" onclick="openResetModal('@row.User.Id')">Reset PW</button>
                                <button class="btn btn-outline-danger"   onclick="deleteUser('@row.User.Id', '@row.User.Email')">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Add User Modal *@
<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Add User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Email</label>
                    <input type="email" class="form-control" id="newEmail" /></div>
                <div class="mb-3"><label class="form-label">Password</label>
                    <input type="password" class="form-control" id="newPw" /></div>
                <div class="mb-3"><label class="form-label">Roles</label>
                    @foreach (var r in Model.AllRoles)
                    {
                        <div class="form-check">
                            <input class="form-check-input new-role-cb" type="checkbox" value="@r" id="nr-@r" />
                            <label class="form-check-label" for="nr-@r">@r</label>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="createUser()">Create</button>
            </div>
        </div>
    </div>
</div>

@* Roles Modal *@
<div class="modal fade" id="rolesModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Edit Roles</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="rolesUserId" />
                @foreach (var r in Model.AllRoles)
                {
                    <div class="form-check">
                        <input class="form-check-input role-cb" type="checkbox" value="@r" id="r-@r" />
                        <label class="form-check-label" for="r-@r">@r</label>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveRoles()">Save</button>
            </div>
        </div>
    </div>
</div>

@* Reset Password Modal *@
<div class="modal fade" id="resetModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Reset Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="resetUserId" />
                <label class="form-label">New Password</label>
                <input type="password" class="form-control" id="newResetPw" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="doReset()">Reset</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openAddModal() {
    document.getElementById('newEmail').value = '';
    document.getElementById('newPw').value = '';
    document.querySelectorAll('.new-role-cb').forEach(cb => cb.checked = false);
    new bootstrap.Modal('#addUserModal').show();
}

async function createUser() {
    const roles = Array.from(document.querySelectorAll('.new-role-cb:checked')).map(cb => cb.value);
    const body = { email: document.getElementById('newEmail').value, password: document.getElementById('newPw').value, roles };
    const r = await csrfFetch('/api/admin/users', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
    if (r.ok) { location.reload(); } else {
        const errs = await r.json().catch(() => null);
        alert('Error: ' + (Array.isArray(errs) ? errs.join('\n') : await r.text()));
    }
}

function openRolesModal(uid) {
    const row = document.getElementById('urow-' + uid);
    const current = row.dataset.roles.split(',').filter(Boolean);
    document.getElementById('rolesUserId').value = uid;
    document.querySelectorAll('.role-cb').forEach(cb => cb.checked = current.includes(cb.value));
    new bootstrap.Modal('#rolesModal').show();
}

async function saveRoles() {
    const uid = document.getElementById('rolesUserId').value;
    const roles = Array.from(document.querySelectorAll('.role-cb:checked')).map(cb => cb.value);
    await csrfFetch('/api/admin/users/' + uid + '/roles', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ roles }) });
    location.reload();
}

function openResetModal(uid) {
    document.getElementById('resetUserId').value = uid;
    document.getElementById('newResetPw').value = '';
    new bootstrap.Modal('#resetModal').show();
}

async function doReset() {
    const uid = document.getElementById('resetUserId').value;
    const newPassword = document.getElementById('newResetPw').value;
    const r = await csrfFetch('/api/admin/users/' + uid + '/reset-password', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ newPassword }) });
    if (r.ok) { bootstrap.Modal.getInstance(document.getElementById('resetModal')).hide(); alert('Password reset.'); }
    else { alert('Error: ' + await r.text()); }
}

async function deleteUser(uid, email) {
    if (!confirm('Delete user ' + email + '?')) return;
    const r = await csrfFetch('/api/admin/users/' + uid, { method: 'DELETE' });
    if (r.ok) { location.reload(); } else { alert('Error: ' + await r.text()); }
}
</script>
}
