@page
@model frcastr.Web.Pages.Admin.DevicesModel
@{
    ViewData["Title"] = "Devices";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-3">
        <h1 class="h3 mb-0 me-auto">Devices</h1>
    </div>

    @if (Model.SharedChannels.Any())
    {
        <div class="alert alert-warning">
            <p class="mb-1 fw-semibold">Two devices are reporting the same channel.</p>
            <ul class="mb-1 small">
                @foreach (var (channel, deviceNames) in Model.SharedChannels)
                {
                    <li><code>@channel</code> is reported by @string.Join(" and ", deviceNames)</li>
                }
            </ul>
            <p class="mb-0 small">
                Their readings share one canonical channel, so all-time records overwrite each other
                and the history graph draws them as one series unless you separate them. Set a
                channel override on <strong>Edit</strong> — for example
                <code>temperature</code> → <code>temperature.outdoor</code> — and accept the
                suggested re-key so the existing rows move with it.
            </p>
        </div>
    }

    @if (!Model.Devices.Any())
    {
        <div class="alert alert-info">
            <p class="mb-1">No devices have reported yet.</p>
            <p class="mb-0 small">
                Devices register themselves the first time they publish. Add an MQTT data source with a
                <code>topicPattern</code> such as <code>frcastr/{device}/state</code> under
                <a asp-page="/Admin/DataSources">Data Sources</a>, then power on a sensor.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr>
                        <th>Device ID</th><th>Name</th><th>Location</th><th>Model</th>
                        <th>Firmware</th><th>Source</th><th>Last Seen</th>
                        <th>Primary</th><th>Enabled</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Devices)
                    {
                        var stale = Model.IsStale(d);
                        <tr id="dev-@d.Id" data-device='@System.Text.Json.JsonSerializer.Serialize(new { d.Id, d.DeviceId, d.Name, d.Location, d.Model, d.IsEnabled, d.OfflineThresholdMinutes, d.ChannelOverrides }, frcastr.Web.Pages.Admin.DevicesModel.JsonOpts)'>
                            <td class="small font-monospace">@d.DeviceId</td>
                            <td class="fw-semibold">@d.Name</td>
                            <td class="small">@(string.IsNullOrWhiteSpace(d.Location) ? "–" : d.Location)</td>
                            <td class="small text-body-secondary">@(string.IsNullOrWhiteSpace(d.Model) ? "–" : d.Model)</td>
                            <td class="small text-body-secondary">@(string.IsNullOrWhiteSpace(d.FirmwareVersion) ? "–" : d.FirmwareVersion)</td>
                            <td class="small">
                                @(d.SourceId is not null && Model.SourceNames.TryGetValue(d.SourceId.Value, out var sn) ? sn : "–")
                            </td>
                            <td class="small">
                                @if (d.LastSeenAt is null)
                                {
                                    <span class="badge text-bg-secondary">never</span>
                                }
                                else if (stale || !d.IsOnline)
                                {
                                    <span class="badge text-bg-danger" title="@d.LastSeenAt?.ToString("u")">
                                        @(!d.IsOnline ? "offline" : "stale") — @d.LastSeenAt?.ToString("MM/dd HH:mm")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-body-secondary" title="@d.LastSeenAt?.ToString("u")">@d.LastSeenAt?.ToString("MM/dd HH:mm")</span>
                                }
                            </td>
                            <td>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" @(d.IsPrimary ? "checked" : "")
                                           onchange="setPrimary(@d.Id, this.checked)"
                                           title="The primary device also answers to the bare channel name (e.g. temperature.outdoor)" />
                                </div>
                            </td>
                            <td>@(d.IsEnabled ? "✓" : "–")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" onclick="openEditModal(@d.Id)">Edit</button>
                                    <button class="btn btn-outline-secondary" onclick="toggleDevice(@d.Id)">@(d.IsEnabled ? "Disable" : "Enable")</button>
                                    <button class="btn btn-outline-danger" onclick="deleteDevice(@d.Id, '@d.Name.Replace("'", "\\'")')">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="small text-body-secondary">
            Devices report under canonical channel names scoped by device, e.g.
            <code>temperature.indoor@@greenhouse-01</code>. Marking a device <strong>primary</strong> also
            publishes its readings under the bare channel name so existing widgets keep working.
            Stale threshold defaults to @Model.GlobalThresholdMinutes minutes.
        </p>
        <p class="small text-body-secondary">
            The channel names themselves come from the data source's <code>fieldMapping</code>, which
            applies to every device on that source. Use <strong>Edit → Channel overrides</strong> to send
            one device's readings somewhere else — an outdoor sensor sharing a source with an indoor one
            needs <code>temperature</code> → <code>temperature.outdoor</code>.
        </p>
    }
</div>

<div class="modal fade" id="deviceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Device</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deviceId" value="0" />
                <div class="row g-3">
                    <div class="col-12"><label class="form-label">Name</label>
                        <input type="text" class="form-control" id="deviceName" /></div>
                    <div class="col-12"><label class="form-label">Location</label>
                        <input type="text" class="form-control" id="deviceLocation" placeholder="Greenhouse" /></div>
                    <div class="col-md-6"><label class="form-label">Model</label>
                        <input type="text" class="form-control" id="deviceModel" placeholder="ESP32-S3" /></div>
                    <div class="col-md-6"><label class="form-label">Offline after (minutes)</label>
                        <input type="number" min="0" class="form-control" id="deviceThreshold" />
                        <div class="form-text">0 inherits the global setting (@Model.GlobalThresholdMinutes min).</div>
                    </div>
                    <div class="col-12"><div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="deviceEnabled" checked />
                        <label class="form-check-label" for="deviceEnabled">Enabled</label>
                    </div></div>

                    <div class="col-12">
                        <hr class="my-1" />
                        <label class="form-label mb-1">Channel overrides</label>
                        <div class="form-text mt-0 mb-2">
                            The data source names channels for all of its devices at once. Map a payload
                            field (<code>temperature</code>) — or the channel the source resolved it to
                            (<code>temperature.indoor</code>) — to the channel this device should use.
                        </div>
                        <div id="overrideRows" class="vstack gap-2"></div>
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2"
                                onclick="addOverrideRow('', '')">Add override</button>
                    </div>

                    <div class="col-12" id="rekeySection" style="display:none">
                        <hr class="my-1" />
                        <label class="form-label mb-1">Stored history</label>
                        <div class="form-text mt-0 mb-2">
                            Overrides only redirect <em>new</em> readings. Fill in a target to move this
                            device's existing rows onto the new channel as well; leave it blank to keep
                            them where they are.
                        </div>
                        <div id="rekeyRows" class="vstack gap-2"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveDevice()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/admin-api.js" asp-append-version="true"></script>
<script>
function escAttr(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function addOverrideRow(field, channel) {
    const row = document.createElement('div');
    row.className = 'input-group input-group-sm override-row';
    row.innerHTML =
        '<input type="text" class="form-control override-field" placeholder="temperature" value="' + escAttr(field) + '" />' +
        '<span class="input-group-text">&rarr;</span>' +
        '<input type="text" class="form-control override-channel" placeholder="temperature.outdoor" value="' + escAttr(channel) + '" />' +
        '<button type="button" class="btn btn-outline-danger" title="Remove">&times;</button>';
    row.querySelector('button').onclick = function () { row.remove(); };
    document.getElementById('overrideRows').appendChild(row);
}

function collectOverrides() {
    const map = {};
    document.querySelectorAll('#overrideRows .override-row').forEach(function (row) {
        const f = row.querySelector('.override-field').value.trim();
        const c = row.querySelector('.override-channel').value.trim();
        if (f && c) map[f] = c;
    });
    return Object.keys(map).length ? JSON.stringify(map) : null;
}

// A stored channel and an override target belong together when they share a family — the part
// before the first dot. "temperature.indoor" and "temperature.outdoor" are the same measurement
// in a different place, which is exactly the rename this panel exists for.
function suggestTarget(storedChannel, overrides) {
    const family = storedChannel.split('.')[0].toLowerCase();
    const hit = Object.keys(overrides).find(function (k) {
        const target = overrides[k];
        return target.toLowerCase() !== storedChannel.toLowerCase() &&
               target.split('.')[0].toLowerCase() === family;
    });
    return hit ? overrides[hit] : null;
}

async function loadStoredChannels(id) {
    const section = document.getElementById('rekeySection');
    const rows = document.getElementById('rekeyRows');
    rows.innerHTML = '';
    section.style.display = 'none';

    let channels;
    try {
        const r = await fetch('/api/admin/devices/' + id + '/channels');
        if (!r.ok) return;
        channels = await r.json();
    } catch (e) { return; }
    if (!channels || !channels.length) return;

    const overrides = JSON.parse(collectOverrides() || '{}');

    channels.forEach(function (c) {
        const counts = c.readings.toLocaleString() + ' readings' +
            (c.aggregates ? ' · ' + c.aggregates.toLocaleString() + ' aggregates' : '') +
            (c.records ? ' · record' : '');
        const suggestion = suggestTarget(c.channel, overrides);

        const row = document.createElement('div');
        row.className = 'rekey-row';
        row.dataset.from = c.channel;
        row.innerHTML =
            '<div class="input-group input-group-sm">' +
            '<span class="input-group-text font-monospace">' + escAttr(c.channel) + '</span>' +
            '<span class="input-group-text">&rarr;</span>' +
            '<input type="text" class="form-control rekey-to" placeholder="leave blank to keep" ' +
                   'value="' + escAttr(suggestion || '') + '" />' +
            '</div>' +
            '<div class="form-text mt-0">' + counts + '</div>';
        rows.appendChild(row);
    });

    section.style.display = '';
}

function collectRekeys() {
    const pairs = [];
    document.querySelectorAll('#rekeyRows .rekey-row').forEach(function (row) {
        const from = row.dataset.from;
        const to = row.querySelector('.rekey-to').value.trim();
        if (to && to.toLowerCase() !== from.toLowerCase()) pairs.push({ from: from, to: to });
    });
    return pairs;
}

function openEditModal(id) {
    const d = JSON.parse(document.getElementById('dev-' + id).dataset.device);
    document.getElementById('deviceId').value = id;
    document.getElementById('deviceName').value = d.name || '';
    document.getElementById('deviceLocation').value = d.location || '';
    document.getElementById('deviceModel').value = d.model || '';
    document.getElementById('deviceThreshold').value = d.offlineThresholdMinutes || 0;
    document.getElementById('deviceEnabled').checked = d.isEnabled;

    document.getElementById('overrideRows').innerHTML = '';
    let overrides = {};
    try { overrides = JSON.parse(d.channelOverrides || '{}'); } catch (e) { overrides = {}; }
    Object.keys(overrides).forEach(function (k) { addOverrideRow(k, overrides[k]); });
    if (!Object.keys(overrides).length) addOverrideRow('', '');

    new bootstrap.Modal('#deviceModal').show();
    loadStoredChannels(id);
}

async function saveDevice() {
    const id = parseInt(document.getElementById('deviceId').value);
    const body = {
        name: document.getElementById('deviceName').value,
        location: document.getElementById('deviceLocation').value,
        model: document.getElementById('deviceModel').value,
        offlineThresholdMinutes: parseInt(document.getElementById('deviceThreshold').value) || 0,
        isEnabled: document.getElementById('deviceEnabled').checked,
        channelOverrides: collectOverrides()
    };
    const r = await fetch('/api/admin/devices/' + id, {
        method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body)
    });
    if (!r.ok) { alert('Error: ' + await r.text()); return; }

    // History only moves when the admin asked for it, so this runs after the save succeeded and
    // reports what it touched rather than doing it silently.
    const pairs = collectRekeys();
    if (pairs.length) {
        const rk = await fetch('/api/admin/devices/' + id + '/rekey', {
            method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(pairs)
        });
        if (!rk.ok) { alert('Saved, but re-keying failed: ' + await rk.text()); return; }
        const res = await rk.json();
        alert('Re-keyed ' + res.readings.toLocaleString() + ' readings, ' +
              res.aggregates.toLocaleString() + ' aggregates and ' +
              (res.records + res.mergedRecords) + ' record row(s).');
    }
    location.reload();
}

async function toggleDevice(id) {
    await adminFetch('/api/admin/devices/' + id + '/toggle', { method: 'POST' });
}

async function setPrimary(id, primary) {
    await adminFetch('/api/admin/devices/' + id + '/primary?primary=' + primary, { method: 'POST' });
}

async function deleteDevice(id, name) {
    if (!confirm('Delete "' + name + '"? Its readings are kept but will no longer be attributed to a device.')) return;
    await adminFetch('/api/admin/devices/' + id, { method: 'DELETE' });
}
</script>
}
