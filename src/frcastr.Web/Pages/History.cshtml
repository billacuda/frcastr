@page
@model frcastr.Web.Pages.HistoryModel
@{
    ViewData["Title"] = "History";
}

<div class="container-fluid py-3">
    <ul class="nav nav-tabs mb-3" id="historyTabs">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-period">Period Summary</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-records">All-Time Records</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-export">Export</button>
        </li>
    </ul>

    <div class="tab-content">
        <!-- Period Summary -->
        <div class="tab-pane fade show active" id="tab-period">
            <div class="row align-items-end mb-3 g-2">
                <div class="col-auto">
                    <select id="periodSelect" class="form-select">
                        <option value="day">Day</option>
                        <option value="week">Week</option>
                        <option value="month">Month</option>
                        <option value="year">Year</option>
                    </select>
                </div>
                <div class="col-auto">
                    <input type="date" id="dateSelect" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" onclick="loadHistory()">Load</button>
                </div>
            </div>
            <div id="historyCharts"></div>
        </div>

        <!-- All-Time Records -->
        <div class="tab-pane fade" id="tab-records">
            <div id="recordsLoading" class="text-muted">Loading…</div>
            <table class="table table-striped d-none" id="recordsTable">
                <thead>
                    <tr>
                        <th>Channel</th>
                        <th>Device</th>
                        <th>All-Time High</th>
                        <th>Date</th>
                        <th>All-Time Low</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody id="recordsBody"></tbody>
            </table>
        </div>

        <!-- Export -->
        <div class="tab-pane fade" id="tab-export">
            <div class="row align-items-end g-2 mb-3">
                <div class="col-auto">
                    <label class="form-label">Period</label>
                    <select id="exportPeriod" class="form-select">
                        <option value="day">Day</option>
                        <option value="week">Week</option>
                        <option value="month">Month</option>
                        <option value="year">Year</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label">Date</label>
                    <input type="date" id="exportDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-auto align-self-end">
                    <a id="exportBtn" href="#" class="btn btn-success">Download CSV</a>
                </div>
            </div>
            <p class="text-muted small">
                CSV includes Timestamp, Channel, Device, Value, Unit columns. Channels are exported
                under their stored names, not their display labels.
            </p>
        </div>
    </div>
</div>

@section Scripts {
<script>
window.frcastrConfig = window.frcastrConfig || {};
window.frcastrConfig.windUnit     = '@Model.WindUnit';
window.frcastrConfig.pressureUnit = '@Model.PressureUnit';
window.frcastrConfig.rainUnit     = '@Model.RainUnit';
window.frcastrConfig.temperatureDecimals = @(Model.TemperatureDecimals ? "true" : "false");
</script>
<script src="~/js/temp-unit.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/date-fns@3.6.0/cdn.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<script>
const CHART_PALETTE = [
    '#0d6efd','#dc3545','#198754','#fd7e14','#6f42c1',
    '#20c997','#d63384','#0dcaf0','#ffc107','#6c757d'
];

let historyChart = null;
let channelLabels = {};

// ── Remembered state ─────────────────────────────────────────────────────────
// localStorage, the same store the dashboard uses for layouts. Every read is guarded: a channel
// that goes away, or hand-edited storage, must not take the page down with it.
const STORE = {
    hidden: 'frcastr-history-hidden',
    colors: 'frcastr-history-colors',
    view:   'frcastr-history-view',
    tab:    'frcastr-history-tab'
};

function readStore(key, fallback) {
    try {
        const raw = localStorage.getItem(key);
        return raw ? JSON.parse(raw) : fallback;
    } catch (e) { return fallback; }
}

function writeStore(key, value) {
    try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) { /* private mode */ }
}

let hiddenSeries = readStore(STORE.hidden, []);
const channelColors = readStore(STORE.colors, {});

function setHidden(key, hidden) {
    const i = hiddenSeries.indexOf(key);
    if (hidden && i < 0) hiddenSeries.push(key);
    if (!hidden && i >= 0) hiddenSeries.splice(i, 1);
    writeStore(STORE.hidden, hiddenSeries);
}

// ── Channel keys and labels ──────────────────────────────────────────────────

// "temperature.indoor" for station-wide points, "temperature.indoor@outdoor-01" for a device's.
// Two sensors on one canonical channel used to land in the same bucket and draw as one line.
function seriesKey(point, devices) {
    const d = point.deviceId != null && devices ? devices[point.deviceId] : null;
    return d ? point.channelName + '@@' + d.deviceKey : point.channelName;
}

function bareChannel(key) {
    const i = key.indexOf('@@');
    return i > 0 ? key.slice(0, i) : key;
}

// Most specific first: the exact key, then the canonical channel, then the key itself.
function labelFor(key) {
    return channelLabels[key] || channelLabels[bareChannel(key)] || key;
}

async function loadChannelLabels() {
    try {
        const r = await fetch('/api/weather/channel-labels');
        channelLabels = r.ok ? await r.json() : {};
    } catch (e) { channelLabels = {}; }
}

function hexToRgba(hex, alpha) {
    const r = parseInt(hex.slice(1,3),16);
    const g = parseInt(hex.slice(3,5),16);
    const b = parseInt(hex.slice(5,7),16);
    return `rgba(${r},${g},${b},${alpha})`;
}

function utcTs(ts) {
    if (!ts) return ts;
    if (ts.endsWith('Z') || /[+-]\d{2}:\d{2}$/.test(ts)) return ts;
    return ts + 'Z';
}

function toF(c)       { return c * 9/5 + 32; }
function toInHg(hpa)  { return hpa * 0.02953; }
function toMmHg(hpa)  { return hpa * 0.75006; }
function toMph(kmh)   { return kmh * 0.62137; }
function toKnots(kmh) { return kmh * 0.53996; }
function toIn(mm)     { return mm * 0.03937; }

function channelConv(ch) {
    const cfg = window.frcastrConfig || {};
    const tu  = window.getTempUnit ? window.getTempUnit() : 'C';
    const tDec = cfg.temperatureDecimals ? 1 : 0;
    if (/^(temperature|dewpoint|feelslike)/.test(ch))
        return tu === 'F' ? { fn: toF,     unit: '°F', dec: tDec }
                          : { fn: null,    unit: '°C', dec: tDec };
    if (/^wind\.(speed|gust)/.test(ch)) {
        const wu = cfg.windUnit || 'kmh';
        if (wu === 'mph')   return { fn: toMph,          unit: 'mph',  dec: 1 };
        if (wu === 'knots') return { fn: toKnots,         unit: 'kn',   dec: 1 };
        if (wu === 'ms')    return { fn: v => v / 3.6,    unit: 'm/s',  dec: 1 };
        return                     { fn: null,             unit: 'km/h', dec: 1 };
    }
    if (/^pressure/.test(ch) || ch === 'pressure') {
        const pu = cfg.pressureUnit || 'hPa';
        if (pu === 'inHg') return { fn: toInHg,  unit: 'inHg', dec: 2 };
        if (pu === 'mmHg') return { fn: toMmHg,  unit: 'mmHg', dec: 0 };
        return                    { fn: null,     unit: 'hPa',  dec: 0 };
    }
    if (/^rain/.test(ch) || ch === 'rainfall') {
        const ru = cfg.rainUnit || 'mm';
        if (ru === 'in') return { fn: toIn, unit: 'in', dec: 2 };
        return                  { fn: null, unit: 'mm', dec: 1 };
    }
    if (/^humidity/.test(ch))    return { fn: null, unit: '%', dec: 0 };
    if (ch === 'wind.direction') return { fn: null, unit: '°', dec: 0 };
    return { fn: null, unit: '', dec: 1 };
}

function convertPoint(ch, rawValue) {
    const c = channelConv(ch);
    const v = c.fn ? c.fn(+rawValue) : +rawValue;
    return +v.toFixed(c.dec);
}

async function loadHistory() {
    const period = document.getElementById('periodSelect').value;
    const date = document.getElementById('dateSelect').value;
    writeStore(STORE.view, { period: period, date: date });

    const res = await fetch(`/api/weather/history?period=${period}&date=${date}`);
    if (!res.ok) return;
    const data = await res.json();
    renderHistoryCharts(data, period);
}

function renderHistoryCharts(data, period) {
    const container = document.getElementById('historyCharts');
    container.innerHTML = '';

    const rawPoints = data.rawPoints || [];
    const aggPoints = data.aggregatePoints || [];
    const devices   = data.devices || {};

    // Series are keyed per device; conversion still keys off the bare channel name, since it picks
    // units and decimals by prefix and must not be handed a device suffix.
    const byChannel = {};
    rawPoints.forEach(p => {
        const key = seriesKey(p, devices);
        (byChannel[key] = byChannel[key] || []).push({
            x: new Date(utcTs(p.timestamp)),
            y: convertPoint(p.channelName, p.value)
        });
    });
    aggPoints.forEach(p => {
        const key = seriesKey(p, devices);
        if (!byChannel[key]) {
            (byChannel[key] = byChannel[key] || []).push({
                x: new Date(utcTs(p.periodStart)),
                y: convertPoint(p.channelName, p.avg)
            });
        }
    });
    Object.values(byChannel).forEach(pts => pts.sort((a, b) => a.x - b.x));

    const channels = Object.keys(byChannel).sort();
    if (!channels.length) {
        container.innerHTML = '<div class="text-muted">No data found for this period.</div>';
        return;
    }

    channels.forEach((ch, i) => {
        if (!channelColors[ch]) channelColors[ch] = CHART_PALETTE[i % CHART_PALETTE.length];
    });

    const layout = document.createElement('div');
    layout.className = 'd-flex gap-3';
    layout.style.cssText = 'min-height:420px;align-items:flex-start';

    const sidebar = document.createElement('div');
    sidebar.style.cssText = 'width:190px;min-width:160px;flex-shrink:0;overflow-y:auto;max-height:420px';
    sidebar.innerHTML = '<div class="small fw-semibold mb-2 text-body-secondary">Channels</div>';

    const chartWrap = document.createElement('div');
    chartWrap.style.cssText = 'flex:1 1 0;min-width:0;position:relative;height:420px';
    const canvas = document.createElement('canvas');
    chartWrap.appendChild(canvas);

    layout.appendChild(sidebar);
    layout.appendChild(chartWrap);
    container.appendChild(layout);

    const timeUnitMap = { day: 'hour', week: 'day', month: 'day', year: 'month' };
    const timeUnit = timeUnitMap[period] || 'hour';

    const datasets = channels.map(ch => ({
        label: labelFor(ch),
        unitLabel: channelConv(bareChannel(ch)).unit,
        data: byChannel[ch],
        pointRadius: 3,
        pointHoverRadius: 5,
        backgroundColor: hexToRgba(channelColors[ch], 0.65),
        borderColor: channelColors[ch],
        borderWidth: 1,
        // Restored rather than defaulted, so a hidden series stays hidden through a reload instead
        // of flashing in and disappearing.
        hidden: hiddenSeries.indexOf(ch) >= 0
    }));

    if (historyChart) { historyChart.destroy(); historyChart = null; }
    historyChart = new Chart(canvas, {
        type: 'scatter',
        data: { datasets },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    type: 'time',
                    time: {
                        unit: timeUnit,
                        tooltipFormat: 'MMM d, h:mm a',
                        displayFormats: { hour: 'h a', day: 'MMM d', week: 'MMM d', month: 'MMM yyyy' }
                    },
                    grid: { display: false }
                },
                y: { beginAtZero: false }
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => {
                            const u = ctx.dataset.unitLabel || '';
                            return `${ctx.dataset.label}: ${ctx.parsed.y}${u ? ' ' + u : ''}`;
                        }
                    }
                }
            }
        }
    });

    channels.forEach((ch, i) => {
        const row = document.createElement('div');
        row.className = 'd-flex align-items-center gap-2 mb-1';

        const device = deviceOf(ch, devices);

        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.className = 'form-check-input flex-shrink-0 mt-0';
        cb.checked = hiddenSeries.indexOf(ch) < 0;
        cb.addEventListener('change', () => {
            historyChart.data.datasets[i].hidden = !cb.checked;
            historyChart.update();
            setHidden(ch, !cb.checked);
        });

        const cp = document.createElement('input');
        cp.type = 'color';
        cp.value = channelColors[ch];
        cp.style.cssText = 'width:24px;height:24px;padding:1px;border:1px solid var(--bs-border-color);border-radius:4px;cursor:pointer;flex-shrink:0';
        cp.title = ch;
        cp.addEventListener('input', () => {
            channelColors[ch] = cp.value;
            const ds = historyChart.data.datasets[i];
            ds.backgroundColor = hexToRgba(cp.value, 0.65);
            ds.borderColor = cp.value;
            historyChart.update();
            writeStore(STORE.colors, channelColors);
        });

        // The label is what you recognize; the key is what you bind and export by, so it stays in
        // the tooltip alongside the device's friendly name.
        const lbl = document.createElement('span');
        lbl.className = 'small text-truncate';
        lbl.textContent = labelFor(ch);
        lbl.title = device ? ch + ' — ' + device.deviceName : ch;

        row.appendChild(cb);
        row.appendChild(cp);
        row.appendChild(lbl);
        sidebar.appendChild(row);
    });
}

// The device behind a series key, for tooltips.
function deviceOf(key, devices) {
    const i = key.indexOf('@@');
    if (i < 0) return null;
    const deviceKey = key.slice(i + 1);
    return Object.values(devices || {}).find(d => d.deviceKey === deviceKey) || null;
}

// Records come back in their canonical stored unit (°C, km/h, hPa, mm, ...); convert to the
// display unit the same way the Period Summary chart does. Temperature channels additionally
// get the smaller-tenths treatment via formatTemp().
function recordCell(channelName, rawValue) {
    if (rawValue == null) return '–';
    if (/^(temperature|dewpoint|feelslike)/.test(channelName)) {
        return window.formatTemp(rawValue) + '&deg;' + window.getTempUnit();
    }
    const c = channelConv(channelName);
    return convertPoint(channelName, rawValue) + ' ' + c.unit;
}

async function loadRecords() {
    const res = await fetch('/api/weather/records');
    if (!res.ok) return;
    const records = await res.json();
    document.getElementById('recordsLoading').classList.add('d-none');
    const tbody = document.getElementById('recordsBody');
    // Records are stored per device, so without the device column two sensors on one channel
    // render as duplicate-looking rows that differ only in their numbers.
    tbody.innerHTML = records.map(r => `
        <tr>
            <td>${escHtml(labelFor(r.channelKey || r.channelName))}</td>
            <td class="small text-body-secondary">${r.deviceName ? escHtml(r.deviceName) : '–'}</td>
            <td>${recordCell(r.channelName, r.allTimeMax)}</td>
            <td>${new Date(utcTs(r.allTimeMaxAt)).toLocaleDateString()}</td>
            <td>${recordCell(r.channelName, r.allTimeMin)}</td>
            <td>${new Date(utcTs(r.allTimeMinAt)).toLocaleDateString()}</td>
        </tr>`).join('');
    document.getElementById('recordsTable').classList.remove('d-none');
}

function updateExportLink() {
    const period = document.getElementById('exportPeriod').value;
    const date = document.getElementById('exportDate').value;
    document.getElementById('exportBtn').href = `/api/weather/export?period=${period}&date=${date}&format=csv`;
}

document.getElementById('exportPeriod').addEventListener('change', updateExportLink);
document.getElementById('exportDate').addEventListener('change', updateExportLink);
updateExportLink();

function escHtml(s) {
    return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
}

// Load records when tab is shown, and remember which tab that was.
document.querySelectorAll('#historyTabs [data-bs-toggle="tab"]').forEach(btn => {
    btn.addEventListener('shown.bs.tab', () => {
        writeStore(STORE.tab, btn.dataset.bsTarget);
        if (btn.dataset.bsTarget === '#tab-records' &&
            !document.getElementById('recordsLoading').classList.contains('d-none')) {
            loadRecords();
        }
    });
});

// Both date pickers are server-rendered with the server's today, and "today" belongs to the
// viewer: a UTC server hands an evening visitor in the Americas tomorrow's date and an empty
// chart. Re-seed them from the browser's own calendar before anything reads them.
function seedTodayLocal() {
    const d = new Date();
    const today = d.getFullYear() + '-' +
        String(d.getMonth() + 1).padStart(2, '0') + '-' +
        String(d.getDate()).padStart(2, '0');
    document.getElementById('dateSelect').value = today;
    document.getElementById('exportDate').value = today;
    updateExportLink();
}

function restoreView() {
    const view = readStore(STORE.view, null);
    if (view && view.period) {
        const p = document.getElementById('periodSelect');
        if ([...p.options].some(o => o.value === view.period)) p.value = view.period;
    }
    if (view && view.date) document.getElementById('dateSelect').value = view.date;

    const tab = readStore(STORE.tab, null);
    if (tab && tab !== '#tab-period') {
        const btn = document.querySelector('#historyTabs [data-bs-target="' + tab + '"]');
        // show() fires shown.bs.tab, which lazy-loads the records table as usual.
        if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
    }
}

// Labels first: the chart, the sidebar and the records table all render through labelFor().
(async function init() {
    await loadChannelLabels();
    seedTodayLocal();
    restoreView();
    loadHistory();
})();

</script>
}
