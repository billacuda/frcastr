@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject frcastr.Core.Interfaces.ISettingsService SettingsSvc
<!DOCTYPE html>
<html lang="en" data-bs-theme="auto" id="htmlRoot">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @(Configuration["Branding:AppName"] ?? "frcastr")</title>
    <link rel="manifest" href="/manifest.json" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gridstack@12/dist/gridstack.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.css" />
    <link rel="stylesheet" href="~/css/weather-animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{ var _logoPath = await SettingsSvc.GetAsync("Branding.Logo"); }
    <nav class="navbar navbar-expand-lg @(ViewData["DashboardPage"] != null ? "dashboard-nav" : "") border-bottom" id="mainNav">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-page="/Index">
                @if (!string.IsNullOrEmpty(_logoPath))
                {
                    <img src="@_logoPath" alt="Logo" style="max-height:32px;" />
                }
                @(Configuration["Branding:AppName"] ?? "frcastr")
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="navCollapse">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item dropdown" id="dashboardNavItem">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" id="dashboardDropdownToggle">Dashboard</a>
                        <ul class="dropdown-menu" id="dashboardMenu">
                            <li><a class="dropdown-item" href="/?dash=Default">Default</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#" id="newDashboardBtn">+ New Dashboard</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/History">History</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Radar">Radar</a>
                    </li>
                </ul>
                <ul class="navbar-nav align-items-center gap-2">
                    <li class="nav-item">
                        <button class="btn btn-sm btn-outline-secondary" id="fullscreenBtn" onclick="toggleFullscreen()" title="Toggle full screen">&#x26F6;</button>
                    </li>
                    <li class="nav-item">
                        <span id="tempUnitToggle" class="nav-link px-1" style="cursor:pointer" onclick="toggleTempUnit()" title="Toggle temperature unit">
                            <span id="tempUnitC" class="fw-bold">C</span><span class="text-muted" style="font-size:0.7em">°</span>
                            <span class="text-muted mx-1">/</span>
                            <span id="tempUnitF" class="text-muted" style="font-size:0.85em">F</span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-sm btn-outline-secondary" id="themeToggle" onclick="toggleTheme()" title="Toggle theme"><span id="themeIcon">🌙</span></button>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (ViewData["DashboardPage"] != null && User.IsInRole("Administrator"))
                        {
                            <li class="nav-item" id="addWidgetNavItem" style="display:none">
                                <button class="btn btn-sm btn-outline-primary" onclick="openAddWidgetModal()">+ Add Widget</button>
                            </li>
                            <li class="nav-item">
                                <button class="btn btn-sm btn-outline-secondary" id="editDashBtn" onclick="toggleDashboardEdit()">Edit</button>
                            </li>
                            <li class="nav-item">
                                <button class="btn btn-sm btn-outline-secondary" onclick="TestMode.open()"
                                        title="Preview widgets with simulated readings (this browser only)">Test</button>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Settings">Settings</a>
                        </li>
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Admin/Index">Admin</a>
                            </li>
                        }
                        <li class="nav-item">
                            <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-sm btn-outline-primary" asp-area="Identity" asp-page="/Account/Login">Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gridstack@12/dist/gridstack-all.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/temp-unit.js" asp-append-version="true"></script>
    <script src="~/js/dashboard-nav.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
