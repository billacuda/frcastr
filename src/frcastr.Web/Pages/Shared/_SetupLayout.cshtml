<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Setup</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f8f9fa; }
        .setup-card { max-width: 600px; margin: 3rem auto; }
        .step-indicator { display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 2rem; }
        .step-indicator .step {
            width: 2rem; height: 2rem; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: .75rem; font-weight: 600;
            background: #dee2e6; color: #6c757d; position: relative;
        }
        .step-indicator .step.active { background: #0d6efd; color: #fff; }
        .step-indicator .step.done { background: #198754; color: #fff; }
        .step-indicator .step:not(:last-child)::after {
            content: ''; position: absolute; left: 100%; top: 50%;
            width: 0.5rem; height: 2px; background: #dee2e6; transform: translateY(-50%);
        }
    </style>
</head>
<body>
    <div class="setup-card">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary">frcastr Setup</h2>
        </div>
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
