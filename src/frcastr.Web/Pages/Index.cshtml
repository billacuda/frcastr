@* ── Test mode ──
   Administrators only, gated here rather than in JavaScript: a non-admin is never sent the panel
   or the script, so window.TestMode does not exist and the dashboard's override hook is
   unreachable. Simulated readings are never recorded — see wwwroot/js/test-mode.js. *@
@if (User.IsInRole("Administrator"))
{
    <div class="offcanvas offcanvas-end" tabindex="-1" id="testModePanel" style="width:min(420px,100vw)">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">Test Mode</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            <p class="small text-body-secondary">
                Simulated readings, drawn over the real ones in this browser only. Nothing is sent to
                the server and nothing is recorded; other viewers keep seeing live weather.
            </p>

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="tmActive" />
                <label class="form-check-label" for="tmActive">Test mode active</label>
            </div>

            <label class="form-label mb-1">Scenarios</label>
            <div class="d-flex flex-wrap gap-1 mb-3" id="tmScenarios"></div>

            <label class="form-label mb-1">Channel values</label>
            <div class="form-text mt-0 mb-2">
                Any channel name works, including ones no sensor reports yet. Temperatures are in
                &deg;C, matching how readings are stored.
            </div>
            <div id="tmRows" class="vstack gap-2"></div>
            <datalist id="tmChannelList"></datalist>
            <button type="button" class="btn btn-sm btn-outline-secondary mt-2"
                    onclick="TestMode.addRow('', '')">Add channel</button>

            <hr />
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm" onclick="TestMode.applyPanel()">Apply</button>
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="TestMode.clearAll()">Clear all</button>
            </div>
        </div>
    </div>
}

<script>
window.frcastrConfig = {
    pollIntervalSeconds: @Model.PollIntervalSeconds,
    kioskMode: @(Model.KioskMode ? "true" : "false"),
    theme: '@Model.Theme',
    isAuthenticated: @(User.Identity?.IsAuthenticated == true ? "true" : "false"),
    isAdmin: @(User.IsInRole("Administrator") ? "true" : "false"),
    windUnit: '@Model.WindUnit',
    pressureUnit: '@Model.PressureUnit',
    rainUnit: '@Model.RainUnit',
    temperatureDecimals: @(Model.TemperatureDecimals ? "true" : "false"),
    stationLat: '@Model.StationLat',
    stationLon: '@Model.StationLon',
    mobileTwoColumn: @(Model.MobileTwoColumn ? "true" : "false")
};
</script>

@section Scripts {
<script src="~/js/weather-widgets.js" asp-append-version="true"></script>
@if (User.IsInRole("Administrator"))
{
    <script src="~/js/test-mode.js" asp-append-version="true"></script>
    <script>
        // Scenario buttons are built from the module so the list lives in one place.
        document.addEventListener('DOMContentLoaded', function () {
            var host = document.getElementById('tmScenarios');
            if (!host || !window.TestMode) return;
            TestMode.scenarioNames().forEach(function (name) {
                var b = document.createElement('button');
                b.type = 'button';
                b.className = 'btn btn-sm btn-outline-secondary';
                b.textContent = name;
                b.onclick = function () { TestMode.applyScenario(name); };
                host.appendChild(b);
            });
        });
    </script>
}
<script src="~/js/dashboard.js" asp-append-version="true"></script>
}
